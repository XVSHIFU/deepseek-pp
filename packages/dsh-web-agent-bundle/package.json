{
  "name": "@deepseek-pp/dsh-web-agent-bundle",
  "version": "0.0.0-private",
  "private": true,
  "description": "Standalone DeepSeek Harness profile bundle backed only by the paired DeepSeek++ browser session",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./readonly-policy": "./src/readonly-policy.ts",
    "./workspace-files-policy": "./src/workspace-files-policy.ts",
    "./harness-tools-policy": "./src/harness-tools-policy.ts",
    "./linux-command-policy": "./src/linux-command-policy.ts",
    "./web-compaction": "./src/web-compaction.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.readonly.patch.yml": "./cordis.readonly.patch.yml",
    "./cordis.workspace-files.patch.yml": "./cordis.workspace-files.patch.yml",
    "./cordis.harness-features.patch.yml": "./cordis.harness-features.patch.yml",
    "./cordis.linux-commands.patch.yml": "./cordis.linux-commands.patch.yml",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src/**/*.ts",
    "bin/**",
    "scripts/seed-profile.mjs",
    "cordis.patch.yml",
    "cordis.readonly.patch.yml",
    "cordis.workspace-files.patch.yml",
    "cordis.harness-features.patch.yml",
    "cordis.linux-commands.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "profile:seed": "node scripts/seed-profile.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
