{
  "name": "@deepseek-pp/dsh-web-agent-bundle",
  "version": "0.0.0-private",
  "private": true,
  "description": "Standalone DeepSeek Harness profile bundle backed only by the paired DeepSeek++ browser session",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./readonly-policy": "./src/readonly-policy.ts",
    "./workspace-files-policy": "./src/workspace-files-policy.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.readonly.patch.yml": "./cordis.readonly.patch.yml",
    "./cordis.workspace-files.patch.yml": "./cordis.workspace-files.patch.yml",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src/**/*.ts",
    "scripts/seed-profile.mjs",
    "cordis.patch.yml",
    "cordis.readonly.patch.yml",
    "cordis.workspace-files.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "profile:seed": "node scripts/seed-profile.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-headless": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-str-replace-editor": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-pp/dsh-llm-deepseek-web": "0.0.0-private",
    "@deepseek-pp/dsh-web-model-transport": "0.0.0-private"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1"
  }
}
